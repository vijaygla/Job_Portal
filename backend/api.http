// User------------------------------------------
@host = http://localhost:9000/api/v1/user

POST {{host}}/register
Content-Type: application/json

{
  "fullName": "Vijay",
  "email": "vijay@gmail.com",
  "phoneNumber": "7763949572",
  "password": "vijay@123",
  "role": "Recruiter"
}

###

